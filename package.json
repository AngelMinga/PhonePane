{
  "name": "phonepane",
  "displayName": "PhonePane",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "angelminga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AngelMinga/PhonePane"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "android",
    "adb",
    "mirror",
    "device",
    "emulator",
    "scrcpy"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "phonePane",
          "title": "PhonePane",
          "icon": "media/phone.svg"
        }
      ]
    },
    "views": {
      "phonePane": [
        {
          "type": "webview",
          "id": "phonePane.mirror",
          "name": "%view.mirror.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "phonePane.selectDevice",
        "title": "%command.selectDevice.title%",
        "category": "PhonePane",
        "icon": "$(device-mobile)"
      },
      {
        "command": "phonePane.pause",
        "title": "%command.pause.title%",
        "category": "PhonePane",
        "icon": "$(debug-pause)"
      },
      {
        "command": "phonePane.resume",
        "title": "%command.resume.title%",
        "category": "PhonePane",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "phonePane.pause",
          "when": "view == phonePane.mirror && !phonePane.paused",
          "group": "navigation@1"
        },
        {
          "command": "phonePane.resume",
          "when": "view == phonePane.mirror && phonePane.paused",
          "group": "navigation@1"
        },
        {
          "command": "phonePane.selectDevice",
          "when": "view == phonePane.mirror",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "phonePane.pause",
          "when": "!phonePane.paused"
        },
        {
          "command": "phonePane.resume",
          "when": "phonePane.paused"
        }
      ]
    },
    "configuration": {
      "title": "PhonePane",
      "properties": {
        "phonePane.adbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.adbPath%"
        },
        "phonePane.frameInterval": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "markdownDescription": "%config.frameInterval%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.0"
  }
}
