{
  "name": "phonepane",
  "displayName": "PhonePane",
  "description": "%extension.description%",
  "version": "0.3.1",
  "publisher": "angelminga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AngelMinga/PhonePane"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "android",
    "adb",
    "mirror",
    "device",
    "emulator",
    "scrcpy"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "phonePane",
          "title": "PhonePane",
          "icon": "media/phone.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "phonePaneRight",
          "title": "PhonePane",
          "icon": "media/phone.svg"
        }
      ]
    },
    "views": {
      "phonePane": [
        {
          "type": "webview",
          "id": "phonePane.mirror",
          "name": "%view.mirror.name%",
          "when": "phonePane.side != right"
        }
      ],
      "phonePaneRight": [
        {
          "type": "webview",
          "id": "phonePane.mirrorRight",
          "name": "%view.mirror.name%",
          "when": "phonePane.side == right"
        }
      ]
    },
    "commands": [
      {
        "command": "phonePane.selectDevice",
        "title": "%command.selectDevice.title%",
        "category": "PhonePane",
        "icon": "$(device-mobile)"
      },
      {
        "command": "phonePane.pause",
        "title": "%command.pause.title%",
        "category": "PhonePane",
        "icon": "$(debug-pause)"
      },
      {
        "command": "phonePane.resume",
        "title": "%command.resume.title%",
        "category": "PhonePane",
        "icon": "$(play)"
      },
      {
        "command": "phonePane.showLog",
        "title": "%command.showLog.title%",
        "category": "PhonePane",
        "icon": "$(output)"
      },
      {
        "command": "phonePane.moveLeft",
        "title": "%command.moveLeft.title%",
        "category": "PhonePane",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "phonePane.moveRight",
        "title": "%command.moveRight.title%",
        "category": "PhonePane",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "phonePane.pause",
          "when": "view =~ /^phonePane\\.mirror/ && !phonePane.paused",
          "group": "navigation@1"
        },
        {
          "command": "phonePane.resume",
          "when": "view =~ /^phonePane\\.mirror/ && phonePane.paused",
          "group": "navigation@1"
        },
        {
          "command": "phonePane.selectDevice",
          "when": "view =~ /^phonePane\\.mirror/",
          "group": "navigation@2"
        },
        {
          "command": "phonePane.showLog",
          "when": "view =~ /^phonePane\\.mirror/",
          "group": "overflow@1"
        },
        {
          "command": "phonePane.moveRight",
          "when": "view =~ /^phonePane\\.mirror/ && phonePane.side != right",
          "group": "navigation@3"
        },
        {
          "command": "phonePane.moveLeft",
          "when": "view =~ /^phonePane\\.mirror/ && phonePane.side == right",
          "group": "navigation@3"
        },
        {
          "command": "phonePane.moveLeft",
          "when": "view =~ /^phonePane\\.mirror/ && phonePane.side != left",
          "group": "overflow@2"
        },
        {
          "command": "phonePane.moveRight",
          "when": "view =~ /^phonePane\\.mirror/ && phonePane.side != right",
          "group": "overflow@2"
        }
      ],
      "commandPalette": [
        {
          "command": "phonePane.pause",
          "when": "!phonePane.paused"
        },
        {
          "command": "phonePane.resume",
          "when": "phonePane.paused"
        }
      ]
    },
    "configuration": {
      "title": "PhonePane",
      "properties": {
        "phonePane.adbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.adbPath%"
        },
        "phonePane.frameInterval": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "markdownDescription": "%config.frameInterval%"
        },
        "phonePane.mode": {
          "type": "string",
          "enum": [
            "auto",
            "scrcpy",
            "screencap"
          ],
          "enumDescriptions": [
            "%config.mode.auto%",
            "%config.mode.scrcpy%",
            "%config.mode.screencap%"
          ],
          "default": "auto",
          "markdownDescription": "%config.mode%"
        },
        "phonePane.scrcpyServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.scrcpyServerPath%"
        },
        "phonePane.maxSize": {
          "type": "number",
          "default": 1280,
          "minimum": 0,
          "markdownDescription": "%config.maxSize%"
        },
        "phonePane.videoBitRate": {
          "type": "number",
          "default": 8000000,
          "minimum": 100000,
          "markdownDescription": "%config.videoBitRate%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.0"
  }
}
